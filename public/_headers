# Cloudflare Pages response headers for spectral-loom.evgenyosipchuk.com.
#
# CSP: everything is served from this origin. blob: is for Tone.js, which starts its clock
# Worker and AudioWorklet from blob URLs. No inline scripts or styles anywhere (page styles
# live in src/page.css). frame-ancestors: only the blog may frame the demo (localhost is the
# blog's dev server), so nobody else can clickjack it.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' blob:; worker-src 'self' blob:; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob:; connect-src 'self' blob: data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors https://evgenyosipchuk.com https://www.evgenyosipchuk.com http://localhost:4321 http://127.0.0.1:4321
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Vite fingerprints everything under assets/, so it can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
